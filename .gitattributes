# Normalise text files to LF in the repository and on checkout where line endings matter.
* text=auto

# Shell scripts, Dockerfiles, compose/YAML and the nginx config must stay LF on every platform
*.sh text eol=lf
*.Dockerfile text eol=lf
Dockerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.conf text eol=lf
.dockerignore text eol=lf
.env.example text eol=lf

# Recorded incident evidence is never converted: line numbers and byte counts must be identical everywhere
incident/**/logs/* -text
incident/**/*.log -text
incident/**/*.csv -text
